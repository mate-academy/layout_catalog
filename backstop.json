{
  "id": "catalog_page",
  "viewports": [
    {
      "label": "small_phone",
      "width": 320,
      "height": 480
    },
    {
      "label": "medium_phone",
      "width": 488,
      "height": 600
    },
    {
      "label": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "label": "desktop_small",
      "width": 1024,
      "height": 768
    },
    {
      "label": "desktop_large",
      "width": 1280,
      "height": 900
    }
  ],
  "scenarios": [
    {
      "label": "Catalog Page - Default",
      "url": "https://Skazochnik2309.github.io/layout_catalog",
      "selectors": [
        "document"
      ],
      "misMatchThreshold": 0.1,
      "requireSameDimensions": false,
      "delay": 500
    },
    {
      "label": "Catalog Page - Nav Hover",
      "url": "https://Skazochnik2309.github.io/layout_catalog",
      "hoverSelector": "[data-qa='nav-hover']",
      "selectors": [
        "document"
      ],
      "misMatchThreshold": 0.1,
      "requireSameDimensions": false,
      "delay": 500
    },
    {
      "label": "Catalog Page - Card Hover",
      "url": "https://Skazochnik2309.github.io/layout_catalog",
      "hoverSelector": "[data-qa='card-hover']",
      "selectors": [
        "document"
      ],
      "misMatchThreshold": 0.1,
      "requireSameDimensions": false,
      "delay": 500
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "engine_scripts": "backstop_data/engine_scripts",
    "html_report": "backstop_data/html_report",
    "ci_report": "backstop_data/ci_report"
  },
  "report": [
    "browser"
  ],
  "engine": "puppeteer",
  "engineOptions": {
    "args": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}
