body {
  font-family: Roboto, sans-serif;
  margin: 0;
  color: #060b35;
}

.catalog {
  display: flex;
  flex-wrap: wrap;

  box-sizing: border-box;
  width: 1024px;
  margin: 0 auto;
  padding: 50px 40px;
}

.catalog__grid {
  margin-right: 48px;
  margin-bottom: 46px;

}

.catalog__grid:nth-child(4n) {
  margin-right: 0;
}

.catalog__grid:nth-last-child(-n + 4) {
  margin-bottom: 0;
}

@media (min-width: 488px) {
  .catalog__grid { grid-template-columns: repeat(2, 200px); }
}

@media (min-width: 768px) {
  .catalog__grid { grid-template-columns: repeat(3, 200px); }
}

@media (min-width: 1024px) {
  .catalog__grid { grid-template-columns: repeat(4, 200px); }
}
