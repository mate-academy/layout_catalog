{
  "name": "catalog-page",
  "version": "1.0.0",
  "description": "Frontend practice with catalog page",
  "scripts": {
    "init": "mate-scripts init",
    "start": "npm-run-all --parallel sass serve",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{html,css,scss}'",
    "lint": "npm run format && mate-scripts lint",
    "test:only": "mate-scripts test",
    "build": "mate-scripts build",
    "deploy": "mate-scripts deploy",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "sass": "sass src/styles/style.scss src/styles/style.css --watch",
    "serve": "live-server src"

  },
  "keywords": [],
  "author": "Mate Academy",
  "license": "GPL-3.0",
  "devDependencies": {
    "@linthtml/linthtml": "^0.9.6",
    "@mate-academy/backstop-config": "latest",
    "@mate-academy/bemlint": "latest",
    "@mate-academy/linthtml-config": "latest",
    "@mate-academy/scripts": "^1.8.6",
    "@mate-academy/stylelint-config": "latest",
    "@parcel/transformer-sass": "^2.12.0",
    "backstopjs": "6.3.23",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "sass": "^1.91.0",
    "stylelint": "^16.7.0",
    "stylelint-scss": "^6.4.1"
  },
  "mateAcademy": {
    "projectType": "layout",
    "linters": {
      "javascript": false
    }
  },
  "main": ".eslintrc.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livadin/layout_catalog.git"
  },
  "bugs": {
    "url": "https://github.com/livadin/layout_catalog/issues"
  },
  "homepage": "https://github.com/livadin/layout_catalog#readme"
}
